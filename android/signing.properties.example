# Haqibati Android Release Signing Template
# Copy this file to android/signing.properties (excluded by .gitignore) or supply
# Gradle properties / environment variables in CI. NEVER commit real credentials.
#
# Required keys for Release packaging:
storeFile=path/to/haqibati-release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=haqibati_upload
keyPassword=CHANGE_ME_KEY_PASSWORD
