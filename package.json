{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_ENABLE_PREVIEW_DEMO=true vite --port=3000 --host=0.0.0.0",
    "build": "NODE_ENV=production vite build --mode production",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "dev:api": "PORT=8081 tsx server.ts",
    "start": "tsx server.ts",
    "test:backend": "firebase emulators:exec --only firestore --project student-learning-platform-2026 \"npx tsx --test tests/backend/backend.api.test.ts tests/backend/entrypointAndRateLimit.test.ts tests/backend/r2StagingLifecycle.test.ts\"",
    "test:rules": "firebase emulators:exec --only firestore --project student-learning-platform-2026 \"npx tsx --test tests/firestore.rules.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase": "^13.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
